_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}], "type": "RSLT", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "frn5le12ob10re2img06.jpg"}, {"text": "<span class=\"strong\">Charlotte</span> : Salut Pierre !<br>\n<span class=\"strong\">Pierre</span> : Salut Charlotte, quoi de neuf ? <br>\n<span class=\"strong\">Charlotte</span> : J'ai eu une formation aujourd'hui.", "id": 1, "time": "100", "image": "frn5le12ob10re2img06.jpg"}, {"text": "<span class=\"strong\">Pierre</span> : C'\u00e9tait comment ?<br>\n<span class=\"strong\">Charlotte</span> : \u00c0 mes yeux, la formation \u00e9tait tr\u00e8s pertinente. Je n'avais pas encore rencontr\u00e9 un technicien de service informatique.<br>\n<span class=\"strong\">Pierre</span> : Est-ce que le syst\u00e8me informatique est compliqu\u00e9 ? <br>\n<span class=\"strong\">Charlotte</span> : Pas vraiment. Il y a deux nouveaux programmes que je dois apprendre : un logiciel de traitement de texte et une base de donn\u00e9es.", "id": 2, "time": "8000", "image": "frn5le12ob10re2img06.jpg"}, {"text": "<span class=\"strong\">Pierre</span> : C'est comment ton espace de travail ? <br>\n<span class=\"strong\">Charlotte</span> : C'est bien. J'ai achet\u00e9 une plante pour le d\u00e9corer. <br>\n<span class=\"strong\">Pierre</span> : C'est tout, juste une plante ? <br>\n<span class=\"strong\">Charlotte</span> : J'\u00e9tais tr\u00e8s occup\u00e9e avec les sondages pour les blogs. \u00c0 ce propos, peux-tu m'aider avec quelque chose ?  <br>\n<span class=\"strong\">Pierre</span> : Bien s\u00fbr, avec plaisir.", "id": 3, "time": "27600", "image": "frn5le12ob10re2img01.jpg"}, {"text": "<span class=\"strong\">Charlotte</span> : Pourrais-tu demander \u00e0 quelques-uns de tes amis de remplir le questionnaire ?   <br>\n<span class=\"strong\">Pierre</span> : D'accord, je peux faire \u00e7a.  <br>\n<span class=\"strong\">Charlotte</span> : Super ! Je pense que plus j'ai de r\u00e9ponses, plus les r\u00e9sultats seront int\u00e9ressants.", "id": 4, "time": "44800", "image": "frn5le12ob10re2img06.jpg"}, {"text": "<span class=\"strong\">Pierre</span> : As-tu un horaire de travail standard ? <br>\n<span class=\"strong\">Charlotte</span> : Quand on est pigiste, \u00e7a d\u00e9pend du jour. <br>\n<span class=\"strong\">Pierre</span> : Auras-tu le temps pour qu'on se parle encore cette fin de semaine ? <br>\n<span class=\"strong\">Charlotte</span> : Oui, ce serait cool. \u00c0 bient\u00f4t.<br>\n<span class=\"strong\">Pierre</span> : D'accord, \u00e0 plus.", "id": 5, "time": "58000", "image": "frn5le12ob10re2img06.jpg"}], "audiosrc": "frn5le12ob10re2aud01", "coverimg": "frn5le12ob10re2img06.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}